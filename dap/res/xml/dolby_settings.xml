<!-- The switch, the modes, then the settings of the selected mode: the dialogue enhancer for
     Movie, the intelligent equalizer presets and the graphic equalizer for Music. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/dolby_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="dolby_enable"
        android:title="@string/dolby_title" />

    <PreferenceCategory
        android:key="dolby_mode_category"
        android:title="@string/dolby_mode_category">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_mode_dynamic"
            android:title="@string/dolby_profile_dynamic" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_mode_movie"
            android:title="@string/dolby_profile_movie" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_mode_music"
            android:title="@string/dolby_profile_music" />

    </PreferenceCategory>

    <PreferenceCategory android:key="dolby_dialogue_category">

        <com.android.settingslib.widget.SliderPreference
            android:key="dolby_dialogue_enhancer"
            android:title="@string/dolby_dialogue_enhancer_title"
            android:persistent="false"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dolby_ieq_category"
        android:title="@string/dolby_ieq_category">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_preset_none"
            android:title="@string/dolby_preset_none" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_preset_detailed"
            android:title="@string/dolby_preset_detailed" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_preset_balanced"
            android:title="@string/dolby_preset_balanced" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="dolby_preset_warm"
            android:title="@string/dolby_preset_warm" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="dolby_geq_category"
        android:title="@string/dolby_geq_title">

        <org.lineageos.dap.EqualizerPreference
            android:key="dolby_geq" />

        <com.android.settingslib.widget.ButtonPreference
            android:key="dolby_geq_reset"
            android:title="@string/dolby_geq_reset"
            app:buttonPreferenceType="outline" />

    </PreferenceCategory>

</PreferenceScreen>
