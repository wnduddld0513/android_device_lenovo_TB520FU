    <!-- Stock animates every colour temperature change over 2000 ms
         (AutoEnvironmentBrightness.updateColorTempByAnimation).  AOSP defaults
         to 1000 ms up and 40000 ms down, which would leave the panel warm for
         ~40 s after the light gets cooler. -->
    <integer name="config_displayWhiteBalanceTransitionTimeIncrease">2000</integer>
    <integer name="config_displayWhiteBalanceTransitionTimeDecrease">2000</integer>

