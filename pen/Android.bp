android_app {
    name: "LenovoPen",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    optimize: {
        optimize: true,
        shrink_resources: true,
    },
}
