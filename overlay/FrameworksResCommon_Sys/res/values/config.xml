<!-- QSSI framework resource overlay
     (product/overlay/FrameworksResCommon_Sys.apk). -->
<resources>
    <!-- Refresh rate.  Without an override AOSP leaves config_defaultRefreshRate at
         60, which DisplayModeDirector turns into a global [0, 60] Hz render vote, so
         scrolling and animations run at 60 fps on the 144 Hz panel.  0 removes the
         global render cap.  The default 120 Hz peak is
         config_defaultPeakRefreshRate in overlay-lineage; the panel modes are
         30/60/90/120/144 (ro.config.lgsi.default_refreshrate=120,
         ro.config.lgsi.surface_flinger.available_refreshrates=30_60_90_120_144). -->
    <integer name="config_defaultRefreshRate">0</integer>
</resources>
