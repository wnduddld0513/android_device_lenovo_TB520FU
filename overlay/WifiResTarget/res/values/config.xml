<!-- Vendor Wi-Fi overlay: Multi-STA concurrency and 802.11be SoftAP. The
     vendor overlay manifest gates these on ro.boot.product.vendor.sku=pineapple;
     this build has a single AOSP Wi-Fi resources package, so the guard is not
     used. -->
<resources>
    <bool name="config_wifiMultiStaLocalOnlyConcurrencyEnabled">true</bool>
    <bool name="config_wifiMultiStaRestrictedConcurrencyEnabled">true</bool>
    <bool name="config_wifiSoftapIeee80211beSupported">true</bool>
</resources>
