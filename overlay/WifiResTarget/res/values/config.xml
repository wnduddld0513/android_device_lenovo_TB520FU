<!-- Values from the stock vendor Wi-Fi overlay (vendor/overlay/WifiResTarget.apk).
     The stock manifest gates it on ro.boot.product.vendor.sku=pineapple because
     the stock image also ships WifiResTarget_spf with the same priority; this
     build has a single AOSP Wi-Fi resources package, so the guard is dropped. -->
<resources>
    <bool name="config_wifiMultiStaLocalOnlyConcurrencyEnabled">true</bool>
    <bool name="config_wifiMultiStaRestrictedConcurrencyEnabled">true</bool>
    <bool name="config_wifiSoftapIeee80211beSupported">true</bool>
</resources>
